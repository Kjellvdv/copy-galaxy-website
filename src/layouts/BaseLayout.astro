---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative image for social cards. */
  ogImage?: string;
}
const { title, description, ogImage = '/og-default.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en" class="scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#05060f" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />
  </head>

  <body class="min-h-dvh bg-void text-chalk antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-plasma focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <slot />

    <footer class="relative z-10 border-t border-edge/60 px-6 py-10 text-sm text-haze">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p>
          The Copy Galaxy, a public swipe file by{' '}
          <a
            href="https://kjellv.com"
            class="text-chalk underline decoration-plasma/60 underline-offset-4 transition hover:decoration-plasma"
            >Kjell Vandevyvere</a
          >.
        </p>
        <p class="font-mono text-xs text-haze/70">
          Screenshots belong to their respective owners.
        </p>
      </div>
    </footer>
  </body>
</html>
