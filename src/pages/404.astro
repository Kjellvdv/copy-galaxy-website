---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import adrift from '../assets/404-adrift.webp';
---

<BaseLayout
  title="Lost in space | The Copy Galaxy"
  description="This page drifted off. The swipe file is still where you left it."
>
  <section class="relative flex min-h-dvh flex-col items-center justify-center overflow-hidden px-6 text-center">
    <Image
      src={adrift}
      alt=""
      widths={[1024, 1600, 2560]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover"
      aria-hidden="true"
    />

    <!--
      Just enough to hold the type, no more. The crop shifts with the viewport so
      the copy can't count on landing somewhere dark, but anything heavier than
      this flattens the nebula into a black rectangle and wastes the image.
      The bottom stop is only there to hand off cleanly to the footer.
    -->
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(34rem 20rem at 50% 50%, color-mix(in oklab, var(--color-void) 58%, transparent), transparent 68%),
        linear-gradient(to bottom, transparent 72%, var(--color-void) 100%)"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 max-w-lg">
      <p class="font-mono text-xs tracking-[0.3em] text-gold">404</p>
      <h1 class="mt-5 text-4xl font-semibold tracking-tight text-star sm:text-5xl">
        Nothing orbits here
      </h1>
      <p class="mx-auto mt-4 text-balance text-lg leading-relaxed text-chalk/80">
        This page drifted off, or never existed in the first place. The swipe file is still
        where you left it.
      </p>
      <a
        href="/"
        class="mt-9 inline-flex items-center gap-2 rounded-xl border border-gold/30 bg-void/70 px-5 py-3 text-sm text-chalk backdrop-blur transition hover:border-gold/70 hover:bg-void/90"
      >
        <span aria-hidden="true">&larr;</span> Back to the galaxy
      </a>
    </div>
  </section>
</BaseLayout>
