---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCategory } from '../config/categories';
import { getIndustry } from '../config/industries';

interface Props { entry: CollectionEntry<'swipe'>; eager?: boolean }
const { entry, eager = false } = Astro.props;
const { title, company, category, industry, tags, screenshot, video } = entry.data;
const cat = getCategory(category);
const ind = getIndustry(industry);

/**
 * Every card keeps its screenshot's real aspect ratio. These are already crops
 * of a page section, so cropping them again to fit a tidy grid throws away the
 * thing you came to look at. The varied heights are what make the grid a bento
 * rather than a spreadsheet — a sticky bar is a strip, a pricing table is a
 * block, and the layout says so before you read a word.
 */
const ratio = +(screenshot.width / screenshot.height).toFixed(4);

/**
 * Rough row span, assuming a ~300px column. The client corrects this from real
 * measurements once images have laid out, but shipping an estimate means the
 * grid is close to right on first paint and still readable with JS switched off.
 */
const GAP = 12;
const META = 88;
const estHeight = 300 / ratio + META;
// Rows are 1px with no row-gap, so the span is just height plus one gutter.
// Exact, rather than rounding up to the next row and leaving ragged space.
const rowSpan = Math.ceil(estHeight) + GAP;

const haystack = [title, company, cat.label, category, ind.label, ind.id, ...ind.aliases, ...tags, entry.body ?? '']
  .join(' ')
  .toLowerCase()
  .replace(/\s+/g, ' ');
---

<a
  href={`/swipe/${entry.id}/`}
  class="swipe-card group block overflow-hidden rounded-2xl border border-edge bg-surface"
  style={`--accent:${cat.accent}; grid-row: span ${rowSpan}`}
  data-card
  data-category={category}
  data-search={haystack}
>
  <div class="relative overflow-hidden bg-deep" style={`aspect-ratio:${ratio}`}>
    <Image
      src={screenshot}
      alt={`${company}: ${title}`}
      widths={[420, 840, 1200]}
      sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 30vw"
      loading={eager ? 'eager' : 'lazy'}
      class="h-full w-full object-cover"
    />
    {
      video && (
        <span class="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-void/80 px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-chalk backdrop-blur">
          <svg class="h-2.5 w-2.5" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
            <path d="M3 1.5v9l7-4.5z" />
          </svg>
          video
        </span>
      )
    }
  </div>

  <div class="border-t border-edge/70 p-4">
    <div class="mb-1.5 flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider">
      <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full" style="background:var(--accent)"></span>
      <span class="text-haze">{cat.label}</span>
      <span class="text-haze/45">/ {ind.label}</span>
    </div>
    <h3 class="text-base leading-snug font-semibold text-star transition-colors group-hover:text-white">
      {title}
    </h3>
    <p class="mt-0.5 text-sm text-haze">{company}</p>
  </div>
</a>
