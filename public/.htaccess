# Static site. WordPress's rewrite rules are gone once this replaces it, so the
# only thing Apache still needs to be told is where the 404 lives — otherwise a
# bad URL gets Apache's default error page instead of the site's.
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed filenames, safe to cache hard.
  <FilesMatch "\.(webp|avif|png|jpe?g|svg|mp4|woff2?)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  # HTML must revalidate or new entries never show up.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
